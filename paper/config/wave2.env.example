# Environment template for Wave 2 GVCF calling (do not commit filled values with secrets).
# Copy and export before running download_and_process.sh / variant_calling.sh.

# GRCh37 reference from the repository README Drive folder
export REF="$PWD/ref/human_g1k_v37.fasta"
export KNOWN_SITES="$PWD/ref/dbsnp_138.b37.vcf"

# Union of UC and JPT capture/exome targets. Not config/targets.bed (UC genes only).
export INTERVALS_BED="$PWD/ref/capture_union.bed"

export RESULTS_DIR="$PWD/gvcf_results"
export BAM_DIR="$PWD/bams/jpt"
export GATK_JAVA_OPTS="-Xmx8g"
export HC_THREADS=4
export SKIP_EXISTING=1

# Keep downloaded JPT BAMs unless disk forces otherwise
export DELETE_BAM_AFTER_GVCF=0

# Default URL list is the 70 modelled JPT samples. Set to 1 only to pull the full 104-file pool.
export ALL_JPT=0
